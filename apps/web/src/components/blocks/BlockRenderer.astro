---
/**
 * Maps a domain block to its Astro component.
 *
 * The `default` branch renders NOTHING rather than throwing: an unknown block
 * must never take a page down. Together with the mapper (which already skips
 * unknown Strapi components), a block added in the CMS ahead of the frontend
 * is harmless.
 *
 * Adding a block: import it and add a case. Step 5 of docs/architecture.md.
 */
import type { Block } from "../../lib/cms/types";
import RichText from "./RichText.astro";

interface Props {
  blocks: Block[];
}
const { blocks } = Astro.props;
---

{
  blocks.map((block) => {
    switch (block.type) {
      case "richText":
        return <RichText block={block} />;
      default:
        return null;
    }
  })
}
