---
/**
 * Renders domain blocks through the block registry. Names no block type.
 *
 * A block without a definition renders NOTHING rather than throwing: an
 * unknown block must never take a page down. Together with the mapper (which
 * already skips unknown Strapi components), a block added in the CMS ahead of
 * the frontend is harmless.
 */
import { BLOCKS } from "../../blocks";
import { definitionFor } from "../../lib/blocks";
import type { Block } from "../../lib/cms/types";

interface Props {
  blocks: Block[];
}
const { blocks } = Astro.props;
---

{
  blocks.map((block) => {
    const Component = definitionFor(BLOCKS, block)?.component as any;
    return Component ? <Component block={block} /> : null;
  })
}
