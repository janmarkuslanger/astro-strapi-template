---
/**
 * Every CMS page, rendered from its blocks. New pages need no code — that is
 * the point of the block model.
 *
 * The "home" slug renders at "/" so editors do not need a special case.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import BlockRenderer from "../components/blocks/BlockRenderer.astro";
import { cms } from "../lib/cms/client";
import { pageSchemas } from "../lib/seo";

export async function getStaticPaths() {
  const pages = await cms.listPages();
  return pages.map((page) => ({
    params: { slug: page.slug === "home" ? undefined : page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const global = await cms.getGlobal();
const siteUrl = String(Astro.site ?? "").replace(/\/$/, "");
---

<BaseLayout
  global={global}
  title={page.seo.title || page.title}
  description={page.seo.description}
  schemas={pageSchemas(page, global, siteUrl)}
>
  <BlockRenderer blocks={page.blocks} />
</BaseLayout>
