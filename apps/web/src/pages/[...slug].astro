---
/**
 * Every CMS page, rendered from its blocks. New pages need no code — that is
 * the point of the block model.
 *
 * The "home" slug renders at "/" (pagePaths), so editors need no special
 * case. Layout and markup are the site's; the routing is the platform's.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import BlockRenderer from "@janmarkuslanger/astro-strapi-platform/astro/BlockRenderer.astro";
import { pagePaths } from "@janmarkuslanger/astro-strapi-platform/astro";
import { BLOCKS } from "../blocks";
import { cms } from "../lib/cms/client";
import { pageSchemas } from "@janmarkuslanger/astro-strapi-platform/core";
import type { InferGetStaticPropsType } from "astro";

// A function declaration: with `export const` (Astro 4) the build ran but
// every page rendered without props.
export function getStaticPaths() {
  return pagePaths(cms);
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
const global = await cms.getGlobal();
const siteUrl = String(Astro.site ?? "").replace(/\/$/, "");
---

<BaseLayout
  global={global}
  title={page.seo.title || page.title}
  description={page.seo.description}
  schemas={pageSchemas(page, global, siteUrl, BLOCKS)}
>
  <BlockRenderer blocks={page.blocks} registry={BLOCKS} />
</BaseLayout>
