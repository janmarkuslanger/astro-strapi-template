---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cms } from "../lib/cms/client";
const global = await cms.getGlobal();
---
<BaseLayout global={global} title={`Not found — ${global.siteName}`}>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-3xl font-bold">Page not found</h1>
    <p class="mt-4"><a href="/" class="underline">Back to the homepage</a></p>
  </section>
</BaseLayout>
