# Build-time CMS address. The frontend always builds against a running Strapi,
# so start one first (npm run dev:cms).
#
# 127.0.0.1, NOT localhost: Node resolves localhost to IPv6 (::1), Strapi
# listens on IPv4. The symptom is ECONNREFUSED ::1:1337.
STRAPI_URL=http://127.0.0.1:1337

# Optional read-only API token, if the content APIs are not public.
# STRAPI_TOKEN=

# CMS address that ends up in the HTML (image sources, form endpoint). Locally
# the same as STRAPI_URL. In PRODUCTION this comes from the committed
# .env.production instead — do not set it in CI or in a hosting UI.
PUBLIC_STRAPI_URL=http://127.0.0.1:1337

# GA4 id. Normally unset locally, so development produces no tracking and no
# banner. Set it only to try the banner out. Production uses .env.production.
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
