HOST=127.0.0.1
PORT=1337
# Public address of the CMS in production (used by Strapi for absolute URLs).
PUBLIC_URL=http://127.0.0.1:1337

# Generate each individually: openssl rand -base64 16
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# sqlite locally, postgres in production
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=

# Frontend domains allowed to call the API
CORS_ORIGINS=http://localhost:4321

# Mail delivery (nodemailer/SMTP) — used by the contact endpoint
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
CONTACT_TO=

# Rebuild on publish — see src/rebuild.ts
#   hook   POST to a deploy hook (Vercel/Netlify/CI). Works from anywhere.
#   script run a local build script (only when CMS and site share a machine)
#   none   handled elsewhere
REBUILD_STRATEGY=none
# REBUILD_HOOK_URL=
# REBUILD_DELAY_MS=20000

# Deliberately NO PUBLIC_* variables here. The frontend's public build config
# lives in apps/web/.env.production so that every build machine agrees on it.
# Putting it here too is exactly the two-sources-of-truth bug in CLAUDE.md §3.
