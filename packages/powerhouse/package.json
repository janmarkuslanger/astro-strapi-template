{
  "name": "@janmarkuslanger/powerhouse",
  "version": "0.1.0",
  "description": "Astro + Strapi platform: domain model and block contract, Strapi adapter, Astro rendering and consent, Strapi schemas and bootstrap helpers.",
  "license": "MIT",
  "type": "module",
  "keywords": ["astro-component", "strapi"],
  "exports": {
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./strapi": { "types": "./dist/strapi/index.d.ts", "import": "./dist/strapi/index.js" },
    "./astro": "./src/astro/index.ts",
    "./astro/BlockRenderer.astro": "./src/astro/BlockRenderer.astro",
    "./strapi-kit": { "types": "./dist/strapi-kit/index.d.ts", "default": "./dist/strapi-kit/index.js" },
    "./strapi-kit/schemas-cli": "./dist/strapi-kit/schemas-cli.js"
  },
  "typesVersions": { "*": { "strapi-kit": ["dist/strapi-kit/index.d.ts"] } },
  "files": ["dist", "src/astro", "schemas"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.strapi-kit.json && node -e \"require('node:fs').copyFileSync('src/strapi-kit/package.json', 'dist/strapi-kit/package.json')\""
  },
  "dependencies": { "marked": "^14.1.3" },
  "peerDependencies": { "astro": "^4.16.0", "@strapi/strapi": "^5.0.0" },
  "peerDependenciesMeta": { "astro": { "optional": true }, "@strapi/strapi": { "optional": true } },
  "devDependencies": { "typescript": "^5.6.3" },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/janmarkuslanger/astro-strapi-template.git", "directory": "packages/powerhouse" }
}
