// Type-checks the tests (vitest itself only strips types). Package sources
// are checked by their own build; apps/web by `astro check`. Imports of other
// packages resolve to their dist/, so `npm test` builds the packages first.
{
  "extends": "./tsconfig.packages.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["astro-modules.d.ts", "packages/*/test", "apps/web/test", "scripts/test", "vitest.config.mts", "vitest.shared.ts"]
}
